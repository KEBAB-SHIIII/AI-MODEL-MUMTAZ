# Konfigurasi Generative AI untuk Endpoint POST /v1/learning-summary/summarize
# Salin file ini menjadi .env lalu isi GEMINI_API_KEY Anda.
# Catatan: Jika GEMINI_API_KEY kosong, endpoint /v1/anomaly/analyze tetap berjalan normal
# sementara /v1/learning-summary/summarize akan mengembalikan HTTP 503.

LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LEARNING_SUMMARY_MODEL=gemini-3.5-flash-lite
LEARNING_SUMMARY_LLM_TIMEOUT_SECONDS=24
LEARNING_SUMMARY_TEMPERATURE=0.25
LEARNING_SUMMARY_MAX_OUTPUT_TOKENS=1536
